# Copy to .env — never commit .env. All keys optional for dry-run.
# Gemini (free tier, Google AI Studio) — LLM triage notes only, advisory.
# The agent never sends secrets, keys, or personal data to any model.
GEMINI_API_KEY=
# BSC public RPC (defaults are fine; override only if one is down)
BSC_RPC_URL=https://bsc-dataseed1.binance.org
# Wallet being protected (read-only checks: balanceOf / ownership)
WALLET_ADDRESS=
# Live execution is OFF unless all three are set AND --live is passed.
# SENTINEL_LIVE=1
# SENTINEL_APPROVAL_TOKEN=
# Max value (wei) a live execution may spend. Hard limit: 0.
SENTINEL_MAX_VALUE_WEI=0
